{
  "name": "the-philosophy-of-shakespeare",
  "version": "0.1.0",
  "description": "Essays exploring Shakespeare's philosophy through close reading of the plays.",
  "license": "",
  "private": "false",
  "main": "index.html",
  "scripts": {
    "build": "npm run clean && npm run clean-prod  && npx eleventy && gulp sass && gulp minify-css && gulp dist-assets && gulp prod-copy && gulp inject-min-css && gulp purgecss && gulp minify-html && node webp.mjs",
    "build-dev": "eleventy && gulp dist-assets && gulp sass",
    "11ty": "eleventy && gulp inject-css",
    "sync": "gulp browser-sync",
    "watch-dev": "npm run build-dev && npm run sync",
    "postinstall": "gulp copy-assets",
    "scss": "node-sass --output-style compressed -o dev/css/ src/scss/theme.scss",
    "watch:all": "onchange './src/' -- npm run build-dev",
    "serve": "eleventy --serve",
    "watch": "npm run clean && npm run build-dev && run-p sync watch:all",
    "clean": "rm -rf dev/*",
    "clean-prod": "rm -rf public/*",
    "test": "npx playwright test"
  },
  "dependencies": {
